# Copy to .env and fill in. NEVER commit the filled-in .env.

# --- Graph store: "neo4j" or "inmemory" ---
# inmemory needs no database, but does not persist between CLI commands.
STORE_TYPE=neo4j

# --- Neo4j (free instance at https://console.neo4j.io — AuraDB Free) ---
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- LLM provider: watsonx | groq | openai | bobshell | fake ---
LLM_PROVIDER=watsonx

# --- IBM watsonx.ai (free IBM Cloud Lite account at https://cloud.ibm.com) ---
# API key:    https://cloud.ibm.com/iam/apikeys
# Project ID: watsonx.ai -> your project -> Manage -> General
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# --- Groq (free, no card, https://console.groq.com -> API Keys) ---
GROQ_API_KEY=

# --- OpenAI-compatible endpoint (also works with Ollama) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Limits ---
ANALYSER_MAX_FILES=150
ANALYSER_MAX_FILE_BYTES=204800

# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
